# Anthropic
ANTHROPIC_API_KEY=

# Database (SQLAlchemy async URL)
DATABASE_URL=postgresql+psycopg://gtm_user:gtm_password@localhost:5432/gtm_ai
# Raw psycopg3 DSN for LangGraph AsyncPostgresSaver
POSTGRES_DSN=postgresql://gtm_user:gtm_password@localhost:5432/gtm_ai

# HubSpot
HUBSPOT_ACCESS_TOKEN=

# Salesforce
SF_USERNAME=
SF_PASSWORD=
SF_SECURITY_TOKEN=
SF_DOMAIN=login

# Google (path to service account JSON file)
GOOGLE_SERVICE_ACCOUNT_JSON=/app/secrets/google-service-account.json

# PostHog
POSTHOG_PROJECT_ID=
POSTHOG_PERSONAL_API_KEY=
POSTHOG_HOST=https://app.posthog.com

# LangFuse
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# App settings
APP_ENV=development
LOG_LEVEL=INFO
CORS_ORIGINS=["http://localhost:5173"]
